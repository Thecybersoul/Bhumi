{
  "expo": {
    "name": "Bhumi",
    "slug": "bhumi",
    "scheme": "bhumiadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "in.bhumiestates.admin",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Bhumi Estates uses the camera to photograph documents and site visits.",
        "NSPhotoLibraryUsageDescription": "Bhumi Estates needs your photos to upload listing images and website media."
      }
    },
    "android": {
      "package": "in.bhumiestates.admin",
      "adaptiveIcon": {
        "backgroundColor": "#0E3B2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3B2E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bhumi Estates needs your photos to upload listing images and website media.",
          "cameraPermission": "Bhumi Estates uses the camera to photograph documents and site visits.",
          "microphonePermission": "Bhumi Estates uses the microphone when you speak to the assistant or dictate a message."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0E3B2E",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Bhumi Estates uses the microphone when you speak to the assistant or dictate a message.",
          "speechRecognitionPermission": "Bhumi Estates turns what you say into text for the assistant and messages.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://www.bhumiestates.in",
      "router": {},
      "eas": {
        "projectId": "a075b466-d2b0-4127-ba48-7964bf02908a"
      }
    },
    "owner": "the-cyber-soul",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a075b466-d2b0-4127-ba48-7964bf02908a"
    }
  }
}
