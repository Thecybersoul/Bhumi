{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bhumi-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "bhumi-app-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd mobile && set EXPO_PUBLIC_API_URL=http://localhost:3000&& npx expo start --web --port 8081 -c"
      ],
      "port": 8081
    },
    {
      "name": "bhumi-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    }
  ]
}