# ─── Supabase (optional) ───────────────────────────────────
# The site renders correctly with these absent — reads fall back
# to the seeded record in lib/data/seed.ts. Set them to go live.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Only needed to run migrations (npm run migrate). The service role
# key above reaches PostgREST and Storage but cannot create a table;
# that needs a real Postgres connection. Dashboard -> Settings ->
# Database -> Connection string -> URI, with your database password
# substituted for the [YOUR-PASSWORD] placeholder. Never deployed —
# this is a local developer credential.
SUPABASE_DB_URL=

# ─── Site ──────────────────────────────────────────────────
# Canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://bhumiestates.in

# ─── Admin ─────────────────────────────────────────────────
# There is no default. Until both are set, admin sign-in is
# refused in production and the dashboard is unreachable.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with:
#   openssl rand -base64 32
# Falls back to ADMIN_PASSWORD if unset. Rotating either value
# invalidates every live session.
AUTH_SECRET=

# ─── Google Calendar / Meet sync (optional) ────────────────
# Without these, /admin/notes-tasks and /admin/setup just don't
# show the calendar-sync option — nothing breaks. To enable: a
# Google Cloud project with the Calendar API enabled, an OAuth
# 2.0 Client ID of type "Web application", and this exact
# redirect URI added to it: <your domain>/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain/api/admin/google/callback
